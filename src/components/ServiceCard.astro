---
// ==================================================
// SECTION: Imports
// ==================================================

import "./ServiceCard.css";

// ==================================================
// SECTION: Component Properties
// ==================================================

const { service, lang = "ar" } = Astro.props;

const locale = lang === "en" ? "en" : "ar";
---

<!-- ==================================================
     SECTION: Service Card
     ================================================== -->

<article class="service-card">

  <!-- SECTION: Service Icon -->
  <div class="service-card__icon" aria-hidden="true">

    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    >

      {service.id === "topographic-surveying" && (
        <>
          <path d="m3 7 6-3 6 3 6-3v13l-6 3-6-3-6 3V7Z" />
          <path d="M9 4v13M15 7v13" />
          <path d="m4 12 3-2 3 2 3-2 3 2 4-2" />
        </>
      )}

      {service.id === "land-boundary-surveying" && (
        <>
          <path d="M3 4h18v16H3z" />
          <path d="m7 8 9-2 2 9-9 3-2-10Z" />
          <circle cx="7" cy="8" r="1" />
          <circle cx="16" cy="6" r="1" />
          <circle cx="18" cy="15" r="1" />
          <circle cx="9" cy="18" r="1" />
        </>
      )}

      {service.id === "construction-setting-out" && (
        <>
          <path d="M3 21h18M6 21l6-15 6 15" />
          <path d="M9 13h6M12 6V3" />
          <rect x="8" y="6" width="8" height="5" rx="1" />
          <circle cx="12" cy="8.5" r="1" />
        </>
      )}

      {service.id === "civil-construction" && (
        <>
          <path d="M3 21h18M5 21V9h14v12" />
          <path d="M8 9V4h8v5M9 13h2M14 13h2M9 17h2M14 17h2" />
          <path d="M3 9h18" />
        </>
      )}

      {service.id === "surveying-equipment-sales" && (
        <>
          <rect x="5" y="3" width="14" height="11" rx="2" />
          <circle cx="12" cy="8.5" r="3" />
          <path d="M9 14 5 21M15 14l4 7M12 14v7" />
          <path d="M9 18h6" />
        </>
      )}

    </svg>

  </div>

  <!-- SECTION: Service Content -->
  <div class="service-card__content">

    <h2 class="service-card__title">
      {service.title[locale]}
    </h2>

    <p class="service-card__description">
      {service.description[locale]}
    </p>

  </div>

</article>