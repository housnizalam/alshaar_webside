
---
// ==================================================
// SECTION: Navbar Properties
// ==================================================

import "./Navbar.css";
import { getTranslations } from "../i18n/ui.js";

const { lang = "ar" } = Astro.props;

const isArabic = lang === "ar";
const t = getTranslations(lang);

const homeUrl = isArabic ? "/ar/" : "/en/";
---

<!-- ==================================================
     SECTION: Main Header
     ================================================== -->

<header class="site-header">

  <!-- ==================================================
       SECTION: Glass Navigation
       ================================================== -->

  <nav
    class="navbar"
    aria-label={isArabic ? "التنقل الرئيسي" : "Main navigation"}
  >

    <!-- SECTION: Language Switcher -->
    <div class="navbar__language" aria-label="Language selection">

      <a
        href="/ar/"
        lang="ar"
        class:list={[
          "navbar__language-link",
          { "navbar__language-link--active": isArabic }
        ]}
        aria-current={isArabic ? "page" : undefined}
      >
        AR
      </a>

      <a
        href="/en/"
        lang="en"
        class:list={[
          "navbar__language-link",
          { "navbar__language-link--active": !isArabic }
        ]}
        aria-current={!isArabic ? "page" : undefined}
      >
        EN
      </a>

    </div>

    <!-- ==================================================
         SECTION: Desktop Navigation
         ================================================== -->

<div class="navbar__links">

  <!-- SECTION: Navigation Icons -->
  <svg class="navbar__icon-defs" aria-hidden="true">
    <defs>
      <symbol id="icon-home" viewBox="0 0 24 24">
        <path d="m3 10 9-7 9 7v10H3z" />
        <path d="M9 20v-7h6v7" />
      </symbol>

      <symbol id="icon-projects" viewBox="0 0 24 24">
        <path d="M4 21V7l8-4v18M12 21V10h8v11" />
        <path d="M7 10h2M7 14h2M7 18h2M15 13h2M15 17h2" />
      </symbol>

      <symbol id="icon-services" viewBox="0 0 24 24">
        <path d="m12 3 9 5-9 5-9-5 9-5Z" />
        <path d="m3 12 9 5 9-5M3 16l9 5 9-5" />
      </symbol>

      <symbol id="icon-about" viewBox="0 0 24 24">
        <circle cx="9" cy="8" r="3" />
        <path d="M3 20v-2a6 6 0 0 1 12 0v2H3Z" />
        <path d="M17 5a3 3 0 0 1 0 6M18 15a5 5 0 0 1 3 5" />
      </symbol>

      <symbol id="icon-certificates" viewBox="0 0 24 24">
        <path d="M6 3h12v12H6z" />
        <path d="M9 7h6M9 10h6M9 15l-2 6 5-3 5 3-2-6" />
      </symbol>

      <symbol id="icon-contact" viewBox="0 0 24 24">
        <path d="M6 3h4l2 5-3 2a14 14 0 0 0 5 5l2-3 5 2v4c0 2-2 3-4 3A15 15 0 0 1 3 7c0-2 1-4 3-4Z" />
      </symbol>
    </defs>
  </svg>

  <!-- Contact -->
  <span class="navbar__link">
    {t.nav.contact}
    <svg class="navbar__icon" aria-hidden="true">
      <use href="#icon-contact" />
    </svg>
  </span>

  <!-- Certificates -->
  <span class="navbar__link">
    {t.nav.certificates}
    <svg class="navbar__icon" aria-hidden="true">
      <use href="#icon-certificates" />
    </svg>
  </span>

  <!-- About -->
  <span class="navbar__link">
    {t.nav.about}
    <svg class="navbar__icon" aria-hidden="true">
      <use href="#icon-about" />
    </svg>
  </span>

  <!-- Services -->
  <span class="navbar__link">
    {t.nav.services}
    <svg class="navbar__icon" aria-hidden="true">
      <use href="#icon-services" />
    </svg>
  </span>

  <!-- Projects -->
  <span class="navbar__link">
    {t.nav.projects}
    <svg class="navbar__icon" aria-hidden="true">
      <use href="#icon-projects" />
    </svg>
  </span>

  <!-- Home -->
  <a
    href={homeUrl}
    class="navbar__link navbar__link--active"
    aria-current="page"
  >
    {t.nav.home}
    <svg class="navbar__icon" aria-hidden="true">
      <use href="#icon-home" />
    </svg>
  </a>

</div>

    <!-- ==================================================
         SECTION: Mobile Navigation
         ================================================== -->

    <details class="mobile-menu">

      <summary
        class="mobile-menu__toggle"
        aria-label={t.nav.menuLabel}
      >
        <span class="mobile-menu__icon">☰</span>
      </summary>

      <div class="mobile-menu__panel">

        <a href={homeUrl} class="mobile-menu__link">
          {t.nav.home}
        </a>

        <span class="mobile-menu__link">{t.nav.projects}</span>
        <span class="mobile-menu__link">{t.nav.services}</span>
        <span class="mobile-menu__link">{t.nav.about}</span>
        <span class="mobile-menu__link">{t.nav.certificates}</span>
        <span class="mobile-menu__link">{t.nav.contact}</span>
        <!-- ==================================================
     SECTION: Mobile Language Selection
     ================================================== -->

<div class="mobile-menu__languages">

  <a
    href="/ar/"
    lang="ar"
    class:list={[
      "mobile-menu__language",
      { "mobile-menu__language--active": isArabic }
    ]}
    aria-current={isArabic ? "page" : undefined}
  >
    العربية
  </a>

  <a
    href="/en/"
    lang="en"
    class:list={[
      "mobile-menu__language",
      { "mobile-menu__language--active": !isArabic }
    ]}
    aria-current={!isArabic ? "page" : undefined}
  >
    English
  </a>

</div>

      </div>

    </details>

  </nav>

  <!-- ==================================================
       SECTION: Header Brand
       ================================================== -->

  <a href={homeUrl} class="navbar__brand">

    <div class="navbar__brand-text">

      <span class="navbar__brand-name">
        {t.brand.name}
      </span>

      <span class="navbar__brand-description">
        {t.brand.description}
      </span>

    </div>

    <img
      src="/images/logo.png"
      alt="AL SHAAR Logo"
      class="navbar__logo"
      width="70"
      height="70"
    />

  </a>

</header>



